# Copy to .env and adjust only for the local or remote worker being qualified. Never put a bearer token here.
STT_IMAGE=my-assistant-stt:nemotron-3.5-q8
STT_MODEL_DIR=./models
STT_MODEL_FILE=nemotron-3.5-asr-streaming-0.6b-Q8_0.gguf
STT_TOKEN_FILE=./secrets/stt-token

# Loopback is the safe default for a local process or SSH/VPN ingress.
STT_BIND_ADDRESS=127.0.0.1
STT_HOST_PORT=18091
STT_MAX_STREAMS=2

# Defaults match the measured one-vCPU/4-GB reference host. Re-qualify after changing them.
STT_MEMORY_LIMIT=1800m
STT_MEMORY_RESERVATION=900m
STT_CPU_SHARES=128
