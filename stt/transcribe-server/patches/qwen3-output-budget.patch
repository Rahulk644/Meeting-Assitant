 // transcript that fills the generation budget before end-of-stream is flagged
 // via transcribe_was_truncated().

-// Per-run generation budget (matches the reference dumper default).
-constexpr int k_max_new = 256;
+// The upstream 256-token cap truncates ordinary 20-30 second Hindi/Hinglish clips because Indic text can
+// require more decoder tokens than Latin text. Qwen's official evaluation uses 1024; 512 avoids ordinary
+// truncation on the 8 GB support floor without letting a pathological repetition loop run twice as long.
+constexpr int k_max_new = 512;
+
+// Greedy Qwen decoding can occasionally enter a non-EOS token cycle. Stop after eight identical periods and
+// retain one period so a user gets the valid prefix instead of hundreds of repeated words. The caller still
+// receives OUTPUT_TRUNCATED because content after the loop cannot be recovered safely.
+bool trim_repeating_suffix(std::vector<int32_t> & tokens) {
+    constexpr size_t k_repeats   = 8;
+    constexpr size_t k_max_cycle = 8;
+    for (size_t period = 1; period <= k_max_cycle; ++period) {
+        const size_t repeated = period * k_repeats;
+        if (tokens.size() < repeated) {
+            continue;
+        }
+        const size_t start = tokens.size() - repeated;
+        bool         match = true;
+        for (size_t i = period; i < repeated; ++i) {
+            if (tokens[start + i] != tokens[start + (i % period)]) {
+                match = false;
+                break;
+            }
+        }
+        if (match) {
+            tokens.resize(start + period);
+            return true;
+        }
+    }
+    return false;
+}

