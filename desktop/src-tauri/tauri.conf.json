{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "My Assistant",
  "version": "0.1.0",
  "identifier": "com.myassistant.desktop",
  "build": {
    "frontendDist": "http://localhost:8790/",
    "devUrl": "http://localhost:8790"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "My Assistant",
        "center": true,
        "width": 1120,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../app/server.js": "webui/server.js",
      "../../app/index.html": "webui/index.html",
      "../../app/overlay.html": "webui/overlay.html",
      "../../app/logo.png": "webui/logo.png",
      "../../app/logo-full.png": "webui/logo-full.png",
      "../../stt/meeting-tap": "stt/meeting-tap",
      "../../stt/transcribe-server/transcribe-server": "stt/transcribe-server/transcribe-server",
      "../../meeting-state/meeting-state": "meeting-state/meeting-state"
    },
    "macOS": {
      "signingIdentity": "My Assistant Dev"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
