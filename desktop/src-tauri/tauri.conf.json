{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "My Assistant",
  "version": "0.1.0",
  "identifier": "com.myassistant.desktop",
  "build": {
    "frontendDist": "http://localhost:8790/",
    "devUrl": "http://localhost:8790"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data:; media-src 'self'; connect-src 'self' http://127.0.0.1:8790; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../web-dist/index.html": "webui/index.html",
      "../web-dist/release-payload.json": "webui/release-payload.json",
      "../web-dist/logo.png": "webui/logo.png",
      "../../LICENSE": "LICENSE",
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../../stt/meeting-tap": "stt/meeting-tap",
      "../../stt/transcribe-server/transcribe-server": "stt/transcribe-server/transcribe-server",
      "../../meeting-state/meeting-state": "meeting-state/meeting-state"
    },
    "macOS": {
      "signingIdentity": "My Assistant Dev",
      "minimumSystemVersion": "14.4"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
