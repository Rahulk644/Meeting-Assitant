{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Assistant",
  "version": "0.1.0",
  "identifier": "com.assistant.app",
  "build": {
    "frontendDist": "../../app",
    "devUrl": "http://localhost:8790"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Assistant",
        "width": 1120,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
