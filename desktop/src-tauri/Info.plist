<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Assistant transcribes your voice on-device during calls. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>Assistant transcribes your voice on-device during calls so you get named, searchable notes.</string>
  <!-- The UI is served from a local server on 127.0.0.1:8790 (all on-device); allow the cleartext load. -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsLocalNetworking</key>
    <true/>
  </dict>
</dict>
</plist>
