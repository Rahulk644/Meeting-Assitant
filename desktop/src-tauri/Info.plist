<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- My Assistant uses your voice on-device for dictation and meeting transcription. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>My Assistant uses the microphone for on-device dictation and to transcribe your side of meetings.</string>
  <key>NSAudioCaptureUsageDescription</key>
  <string>My Assistant captures meeting-app audio on-device so other participants can be transcribed without a meeting bot.</string>
  <!-- The UI is served from a local server on 127.0.0.1:8790 (all on-device); allow the cleartext load. -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsLocalNetworking</key>
    <true/>
  </dict>
</dict>
</plist>
