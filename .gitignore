# Transcription models — downloaded by ./setup.sh (too large for git)
stt/whisper/*.bin
stt/whisper/*.gguf
stt/whisper/bin/

# Native build artifacts — built by ./setup.sh
stt/meeting-tap
meeting-state/meeting-state
stt/transcribe-server/transcribe-server
stt/transcribe-server/.transcribe.cpp/

# Packaged app + installer — produced by `tauri build` / desktop/make-dmg.sh
# (normally only ever under desktop/src-tauri/target/, which is ignored; belt-and-braces
#  so a stray bundle in the repo root can never be staged)
*.app
*.dmg

# Go-to-market pack (business material, not code) — MUST NOT be committed
gtm-workflows/

# macOS / editor
.DS_Store
*.swp
.codex/

# Node
node_modules/
desktop/web-dist/
# Official standalone Node runtime staged for portable macOS bundles.
desktop/runtime/

# Runtime logs / scratch
*.log
/tmp/mt-*.log

# Saved meetings (local history)
/data/
