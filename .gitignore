# Transcription models — downloaded by ./setup.sh (too large for git)
stt/whisper/*.bin
stt/whisper/*.gguf
stt/whisper/bin/
stt/whisper/polish/

# Native build artifacts — built by ./setup.sh
stt/meeting-tap
meeting-state/meeting-state
agent-context/agent-context
agent-action/agent-action
dictation-target/dictation-target
polish-runtime/llama-server
stt/transcribe-server/transcribe-server
stt/transcribe-server/.transcribe.cpp/
.build/

# Packaged app + installer — produced by `tauri build` / desktop/make-dmg.sh
# (normally only ever under desktop/src-tauri/target/, which is ignored; belt-and-braces
#  so a stray bundle in the repo root can never be staged)
*.app
*.dmg

# Go-to-market pack (business material, not code) — MUST NOT be committed
gtm-workflows/

# Local product-demo projects and rendered media are maintained separately.
/videos/

# macOS / editor
.DS_Store
*.swp
.codex/
.playwright-cli/

# Node
node_modules/
desktop/web-dist/

# Python benchmark tooling
__pycache__/
*.py[cod]

# Runtime logs / scratch
*.log
/tmp/mt-*.log

# Saved meetings (local history)
/data/

# Human acceptance evidence (screenshots, logs, meeting details) is private by default.
/acceptance/sessions/
